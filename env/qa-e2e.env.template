# Copy to env/qa-e2e.env (gitignored) to run `task e2e:qa` from your machine.
#
# This lane signs in with a password, which QA accepts on purpose
# (DISABLE_PASSWORD_LOGIN=0, druthers-infra gcp/env.qa.sh) and prod does not.
# The specs WRITE to the QA database - they add a title, rank it, and clean up
# after themselves. Never point this at prod.
E2E_BASE_URL=https://qa.druthers.io

# The api behind that web app. REQUIRED whenever E2E_BASE_URL is not local:
# the cleanup helper reads and DELETES through it, and a mismatch means acting
# on a different database from the one under test. The lane refuses to run if
# these two disagree.
E2E_API_BASE_URL=https://api-qa.druthers.io

# The dev cast, seeded into QA by the api's seed_qa_cast step on every QA
# deploy. Same shared password as local dev, so a spec file runs unchanged
# against either environment.
E2E_CAST_PASSWORD=change-me

# admin-two alone, because it is an admin account: on a deployed environment a
# shared known password on it would be admin access to that environment's data.
# Must match the QA_ADMIN_TWO_PASSWORD secret in druthers-api, which is what
# the deploy seeds it with. Leave unset and admin-two is not seeded at all, and
# the specs that need a second admin skip.
E2E_ADMIN_TWO_PASSWORD=

# The target seat the cast is anchored to ("you"). On QA this is the dedicated
# e2e account, NOT the real Google account whose library QA inherits from the
# prod branch.
E2E_TARGET_EMAIL=
E2E_TARGET_PASSWORD=
E2E_TARGET_HANDLE=you
